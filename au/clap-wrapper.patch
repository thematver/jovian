+void WrapAsAUV2::flushParamsOnMainThread()
+{
+  if (!_plugin || !_plugin->_ext._params) return;
+  clap_input_events_t in{nullptr, [](const clap_input_events_t *) -> uint32_t { return 0; },
+                         [](const clap_input_events_t *, uint32_t) -> const clap_event_header_t *
+                         { return nullptr; }};
+  clap_output_events_t out{this, [](const clap_output_events_t *list, const clap_event_header_t *ev) -> bool
+                           {
+                             auto self = static_cast<WrapAsAUV2 *>(list->ctx);
+                             if (ev->space_id != CLAP_CORE_EVENT_SPACE_ID) return true;
+                             switch (ev->type)
+                             {
+                               case CLAP_EVENT_PARAM_VALUE:
+                                 self->onPerformEdit(reinterpret_cast<const clap_event_param_value_t *>(ev));
+                                 break;
+                               case CLAP_EVENT_PARAM_GESTURE_BEGIN:
+                                 self->onBeginEdit(reinterpret_cast<const clap_event_param_gesture_t *>(ev)->param_id);
+                                 break;
+                               case CLAP_EVENT_PARAM_GESTURE_END:
+                                 self->onEndEdit(reinterpret_cast<const clap_event_param_gesture_t *>(ev)->param_id);
+                                 break;
+                               default:
+                                 break;
+                             }
+                             return true;
+                           }};
+  auto guarantee_mainthread = _plugin->AlwaysMainThread();
+  _plugin->_ext._params->flush(_plugin->_plugin, &in, &out);
+}
+
 void WrapAsAUV2::onIdle()
 {
   if (!_plugin) return;
+  if (_flushRequested.load())
+  {
+    // only when the audio thread is idle: flush must not run concurrently with process()
+    static mach_timebase_info_data_t tb = []
+    {
+      mach_timebase_info_data_t t;
+      mach_timebase_info(&t);
+      return t;
+    }();
+    uint64_t now = mach_absolute_time();
+    uint64_t last = _lastRenderTicks.load(std::memory_order_relaxed);
+    uint64_t ms = (now - last) * tb.numer / tb.denom / 1000000;
+    _flushRequested.store(false);
+    if (last == 0 || ms > 100) flushParamsOnMainThread();
+  }
   // run queue stuff
   queueEvent e;
